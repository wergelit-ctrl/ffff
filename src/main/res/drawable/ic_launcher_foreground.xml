<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground слой адаптивной иконки FinFocus.
    108×108dp canvas, safe zone 72×72dp по центру.
    Иконка: стилизованный график роста + монета.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Фон кружка -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M54,54m-40,0a40,40 0 1,0 80,0a40,40 0 1,0 -80,0" />

    <!-- Линия графика роста (упрощённая ломаная) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M30,66 L40,54 L50,58 L62,40 L74,44" />

    <!-- Стрелка вверх в конце графика -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M68,38 L74,44 L68,50" />

    <!-- Монета (кружок с символом Br) -->
    <path
        android:fillColor="#FFD54F"
        android:pathData="M38,72m-8,0a8,8 0 1,0 16,0a8,8 0 1,0 -16,0" />

    <!-- Символ Br в монете -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M35,69 L35,75 M35,69 C35,69 40,69 40,71 C40,73 35,73 35,73" />

</vector>
